rules_version = '2';

// ── EDIT OWNER_EMAIL BELOW to match OWNER_EMAIL in js/firebase-config.js.
// Keep both in sync — this file is what actually enforces admin-only
// access; firebase-config.js only controls what the UI shows. Every
// other admin is NOT listed here — they're added dynamically at
// /admins/{email} by the owner, from the app's Manage Admins tab.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return request.auth != null &&
        request.auth.token.email == "radwar0224@gmail.com";
    }
    // Owner always counts as admin; anyone else needs a matching
    // /admins/{their email} document (added by the owner).
    function isAdmin() {
      return isOwner() ||
        (request.auth != null &&
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }

    // The admin roster itself. Every admin can read it (so the app can
    // show who else has access); only the owner can add or remove
    // entries — that's the one thing that stays exclusive to them.
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }

    // Username -> real-email lookup for username-based admin accounts
    // (created by the owner from Manage Admins — see /admins/{email}
    // above; the "email" is an internal-only address, never a real
    // inbox). Has to be publicly readable since the login screen needs
    // to resolve a username *before* anyone is signed in; nothing
    // sensitive lives here — actual admin data still requires a real,
    // authorized signed-in admin per every rule below. Only the owner
    // creates these, same as the admin roster itself.
    match /usernames/{username} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Denormalized audit queue for the automatic temperature-photo check
    // (Cloud Function only — written via the Admin SDK, which bypasses
    // these rules entirely, so `create`/`delete` here are admin-only as
    // a belt-and-suspenders default rather than something the Function
    // actually needs). Admins can read the list and flip `reviewed` to
    // true once they've looked at a flag.
    match /aiFlagged/{flagId} {
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow create, delete: if isAdmin();
    }

    // Store roster: every signed-in viewer (including anonymous
    // associates) can read it to populate the store dropdown; only
    // admins can add/edit/remove stores.
    match /stores/{storeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Live checklist edits (hide/reword a built-in question, add a new
    // one). Associates need to read this to build their walkthrough;
    // only admins can change it.
    match /checklistOverrides/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Daily submissions: any signed-in viewer (anonymous associates
    // included) can create/update — they need to submit their store's
    // walkthrough without an admin in the loop. Reads are signed-in-only
    // (not public) so the data isn't open to the whole internet; the
    // admin dashboard route itself is additionally gated by the isAdmin()
    // check above. Only admins can delete a submission outright.
    match /submissions/{submissionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();

      // Corrective-action photos, one doc per flagged item, stored as
      // base64 image data (there's no Cloud Storage in this app — it
      // requires a billing account even for free-tier usage). Rules
      // don't cascade to subcollections, so this needs its own match
      // even though it lives under a submission.
      match /photos/{photoId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isAdmin();
      }
    }
  }
}
