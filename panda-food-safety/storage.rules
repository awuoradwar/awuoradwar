rules_version = '2';

// Corrective-action photos, one per flagged checklist item, uploaded by
// whoever is running that day's walkthrough. Capped at 8 MB (the app
// itself compresses to well under 1 MB before upload; this is just a
// backstop) and restricted to image content types.
service firebase.storage {
  match /b/{bucket}/o {
    match /submissions/{submissionId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }
  }
}
